{
  "policies": {
    "DisableAppUpdate": true,
    "DisplayBookmarksToolbar": true,
    "NoDefaultBookmarks": true,
    "Bookmarks": [
      { "Title": "Exploit-DB", "URL": "https://www.exploit-db.com/", "Placement": "toolbar", "Folder": "Pentest" },
      { "Title": "Pentest Everything", "URL": "https://viperone.gitbook.io/pentest-everything", "Placement": "toolbar", "Folder": "Pentest" },
      { "Title": "PayloadsAllTheThings", "URL": "https://swisskyrepo.github.io/PayloadsAllTheThings/", "Placement": "toolbar", "Folder": "Pentest" },
      { "Title": "InternalAllTheThings", "URL": "https://swisskyrepo.github.io/InternalAllTheThings/", "Placement": "toolbar", "Folder": "Pentest" },
      { "Title": "WADComs", "URL": "https://wadcoms.github.io/", "Placement": "toolbar", "Folder": "Pentest" },
      { "Title": "GTFOBins", "URL": "https://gtfobins.org/", "Placement": "toolbar", "Folder": "Pentest" },
      { "Title": "HackTricks", "URL": "https://book.hacktricks.wiki/en/index.html", "Placement": "toolbar", "Folder": "Pentest" },
      { "Title": "Weakpass", "URL": "https://weakpass.com/", "Placement": "toolbar", "Folder": "Pentest" },
      { "Title": "AD Mindmap", "URL": "https://orange-cyberdefense.github.io/ocd-mindmaps/img/mindmap_ad_dark_classic_2025.03.excalidraw.svg", "Placement": "toolbar", "Folder": "Pentest" }
    ],
    "OverrideFirstRunPage": "",
    "OverridePostUpdatePage": "",
    "Homepage": {
      "URL": "https://www.google.com",
      "Locked": false,
      "StartPage": "homepage"
    },
    "SearchEngines": {
      "Default": "Google",
      "PreventInstalls": true
    },
    "SearchSuggestEnabled": false,
    "DisableTelemetry": true,
    "CaptivePortal": false,
    "Cookies": {
      "Default": true,
      "AcceptThirdParty": "never",
      "RejectTracker": true
    },
    "DNSOverHTTPS": {
      "Enabled": false
    },
    "UserMessaging": {
      "WhatsNew": false,
      "ExtensionRecommendations": false,
      "FeatureRecommendations": false,
      "UrlbarInterventions": false,
      "SkipOnboarding": true
    },
    "DisableFeedbackCommands": true,
    "DisableFirefoxStudies": true,
    "DisablePocket": true,
    "DontCheckDefaultBrowser": true,
    "EnableTrackingProtection": {
      "Value": true,
      "Cryptomining": true,
      "Fingerprinting": true
    },
    "Extensions": {
      "Install": [
{% for item in FirefoxPlugins %}
        "https://addons.mozilla.org/firefox/downloads/latest/{{ item }}/latest.xpi"{{ "," if not loop.last }}
{% endfor %}
      ]
    },
    "FirefoxHome": {
      "Search": true,
      "TopSites": true,
      "Highlights": false,
      "Pocket": false,
      "Snippets": false,
      "Locked": false
    },
    "HardwareAcceleration": true,
    "NetworkPrediction": false,
    "PopupBlocking": {
      "Allow": [],
      "Default": false,
      "Locked": false
    },
    "PromptForDownloadLocation": true,
    "SupportMenu": {
      "Title": "Kali Support",
      "URL": "https://www.kali.org/docs/",
      "AccessKey": "S"
    }
  }
}
