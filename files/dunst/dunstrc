# dunst notification daemon — dark theme matching the i3bar.

[global]
    font = JetBrainsMono Nerd Font 13
    # Top-right, offset down so it clears the 34px i3bar (34 + 10px gap).
    origin = top-right
    offset = (10, 44)
    width = 420
    height = (0, 300)
    notification_limit = 5
    padding = 14
    horizontal_padding = 16
    frame_width = 2
    frame_color = "#82c8ff"
    separator_color = frame
    corner_radius = 4
    gap_size = 4
    markup = full
    format = "<b>%s</b>\n%b"
    word_wrap = yes
    show_indicators = no
    icon_position = left
    idle_threshold = 120
    mouse_left_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#1c1d2b"
    foreground = "#aaaaaa"
    timeout = 5

[urgency_normal]
    background = "#1c1d2b"
    foreground = "#e6fff5"
    timeout = 8

[urgency_critical]
    background = "#1c1d2b"
    foreground = "#ffffff"
    frame_color = "#900000"
    timeout = 0
